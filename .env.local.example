# Copy to .env.local and fill in. Used by the contact form (app/actions/contact.ts).

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
# In Resend test mode (From = onboarding@resend.dev), this MUST be the email of
# your Resend account owner. Verify a domain in Resend to send anywhere / from a
# custom address.
CONTACT_TO_EMAIL=sidotidavide@gmail.com
